	)
	(text "LED array notes:\n- Connect LEDs in series (3x), to increase efficiency and resistance\nrequired for resistors\n	- 12v - (3.2*3) = 2.4V\n	- R = V / I; R = 2.4 / 0.02A; 120 Ohms required\n	- Resistors not needed when paired with current controlled LED driver\nbut having them enables hook up to bench power."
		(exclude_from_sim no)
		(at 121.412 69.342 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3680c687-9f57-4d41-8e5c-df41d298c747")
	)
	(text "Connectors\n"
		(exclude_from_sim no)
		(at 198.882 109.728 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "38a5977c-e60b-4a2e-9521-5555debbdc4b")
	)
	(text "LED array \n"
		(exclude_from_sim no)
		(at 130.81 18.796 0)
		(effects
