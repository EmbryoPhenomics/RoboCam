				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "3d5eabbf-5a3a-4d39-b8b4-5a903f997993")
	)
	(text "Resistor (Rset = R13) calculation:\n- I_LED = V_thd / R_set\n- V_thd = 0.1\n- I_LED = 0.24 (0.02 * 12)\n- R_set = 420 Ohm (416R actual)\n\nV_thd from AL8860-WT datasheet."
		(exclude_from_sim no)
		(at 70.358 40.132 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4e775026-652a-4eee-87e7-ae09194086af")
	)
