	)
	(text "Voltage divider notes:\n- CTRL pin on AL8860 needs to be 0.4V (0%) to \n2.5V (100%) to control LED brightness.\n- Voltage is adjusted through a digi-pot, but \nneeds to be paired with resistors (R1 & R2) \nto provide correct voltage. \n\n- For +3.3v input:\n	- R1 = 3.3k, R2 = 470R + DS3502\n\nBased on following formula: \n	- R2 = (Vout * R1) / (Vin - Vout)\n	- Vout = (R2 / (R1 + R2)) * Vin"
		(exclude_from_sim no)
		(at 90.678 166.116 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a87c92c4-6ed0-4e6b-840e-6d7e9b1dfaff")
	)
